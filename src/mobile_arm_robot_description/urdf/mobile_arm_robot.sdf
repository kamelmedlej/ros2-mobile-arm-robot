      <!-- Small distance sensor mounted near the top of the fixed arm -->
      <visual name="arm_front_distance_sensor_visual">
        <pose>0.045 0.014808 0.372 0 0 3.14159</pose>

        <geometry>
          <box>
            <size>0.014 0.008 0.006</size>
          </box>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>

      <!-- Narrow ray sensor: behaves like a small ToF / proximity sensor -->
      <sensor name="arm_front_distance_sensor" type="gpu_lidar">
        <pose>0.045 0.014808 0.372 0 0 3.14159</pose>

        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>15</update_rate>

        <topic>/arm_front_lidar</topic>

        <ray>
          <scan>
            <horizontal>
              <samples>181</samples>
              <resolution>1</resolution>

              <!-- About 14 degrees total field of view -->
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.05</min>
            <max>2.00</max>
            <resolution>0.005</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </ray>
      </sensor>

      <!-- Tiny lower front sensor, mounted under the robot camera -->
            <!-- Small visible mount connecting the lower sensor to the robot body -->
      

<visual name="lower_front_distance_sensor_visual">
        <!-- Same X/Y as robot camera, but lower -->
        <pose>-0.133238 0.001833 -0.075 0 0 3.14159</pose>

        <geometry>
          <box>
            <!-- 8 x 6 x 3 mm -->
            <size>0.008 0.006 0.003</size>
          </box>
        </geometry>

        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
      </visual>

      <!-- Low obstacle detector -->
      <sensor name="lower_front_distance_sensor" type="gpu_lidar">
        <!-- yaw=pi: look toward the real robot front, negative X -->
        <pose>-0.133238 0.001833 -0.075 0 0 3.14159</pose>

        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>20</update_rate>

        <topic>/lower_front_lidar</topic>

        <ray>
          <scan>
            <horizontal>
              <samples>121</samples>
              <resolution>1</resolution>

              <!-- 120 degree field of view -->
              <min_angle>-1.0472</min_angle>
              <max_angle>1.0472</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.04</min>
            <max>1.50</max>
            <resolution>0.005</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </ray>
      </sensor>

      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>-0.0908615203408174 0.00179684818200293 0.04 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>/lidar</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.20</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>

      <sensor name="robot_camera_sensor" type="camera">
        <pose>-0.133237695032014 0.00183257540465381 -0.0160127626540696 0 0 3.14159</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>30</update_rate>
        <topic>/robot_camera/image</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>


</link>
